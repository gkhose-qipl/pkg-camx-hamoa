#!/usr/bin/make -f

%:
	dh $@

override_dh_shlibdeps:
	dh_shlibdeps \
		-l/usr/lib/aarch64-linux-gnu/camx/hamoa \
		-l/usr/lib/aarch64-linux-gnu/camx/hamoa/hw

maintainerclean:
	rm -r \
		LICENSE.qcom-2 \
		camx-entitled-headers-dev/ \
		camx-hamoa-dbgsym/ \
		camx-hamoa-dev/ \
		camx-hamoa/ \
		libcamx-dev/ \
		libcamx-hamoa-dev/ \
		libcamx-hamoa1-dbgsym/ \
		libcamx-hamoa1/

override_dh_strip:
	# Don't strip DSP skel files
	dh_strip --exclude=libhme_dsp_skel.so
